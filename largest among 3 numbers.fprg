<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="largest among 3 numbers"/>
        <attribute name="authors" value="jpc06"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-01-06 08:45:16 PM"/>
        <attribute name="created" value="anBjMDY7QVNVU1ZJVk9CT09LOzIwMjYtMDEtMDY7MDg6NDA6MTAgUE07MjYzMg=="/>
        <attribute name="edited" value="anBjMDY7QVNVU1ZJVk9CT09LOzIwMjYtMDEtMDY7MDg6NDU6MTYgUE07MTsyNzUx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1" type="Integer" array="False" size=""/>
            <declare name="num2" type="Integer" array="False" size=""/>
            <declare name="num3" type="Integer" array="False" size=""/>
            <input variable="num1"/>
            <input variable="num2"/>
            <input variable="num3"/>
            <if expression="num1&gt;num2 and num1&gt;num3">
                <then>
                    <output expression="num1&amp;&quot;is bigger&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="num2&gt;num1 and num2&gt;num3">
                        <then>
                            <output expression="num2&amp;&quot;is bigger&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="num3&amp;&quot;is bigger&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
