<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="sum of even number between  1 to 100"/>
        <attribute name="authors" value="jpc06"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-01-06 09:29:26 PM"/>
        <attribute name="created" value="anBjMDY7QVNVU1ZJVk9CT09LOzIwMjYtMDEtMDY7MDk6MjU6NTAgUE07MjY0MA=="/>
        <attribute name="edited" value="anBjMDY7QVNVU1ZJVk9CT09LOzIwMjYtMDEtMDY7MDk6Mjk6MjYgUE07MTsyNzU1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="sum" type="Integer" array="False" size=""/>
            <assign variable="sum" expression="0"/>
            <for variable="i" start="1" end="100" direction="inc" step="1">
                <if expression="i%2==0">
                    <then>
                        <assign variable="sum" expression="sum+i"/>
                        <output expression="sum" newline="True"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
