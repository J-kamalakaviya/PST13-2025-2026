<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="print number 1 to 10 using iteration"/>
        <attribute name="authors" value="jpc06"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-01-06 09:25:46 PM"/>
        <attribute name="created" value="anBjMDY7QVNVU1ZJVk9CT09LOzIwMjYtMDEtMDY7MDk6MDA6NTcgUE07MjY0MA=="/>
        <attribute name="edited" value="anBjMDY7QVNVU1ZJVk9CT09LOzIwMjYtMDEtMDY7MDk6MjU6NDYgUE07MTsyNzUz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="counter" type="Integer" array="False" size=""/>
            <assign variable="counter" expression="1"/>
            <while expression="counter&lt;=10">
                <output expression="counter" newline="True"/>
                <assign variable="counter" expression="counter+1"/>
            </while>
        </body>
    </function>
</flowgorithm>
