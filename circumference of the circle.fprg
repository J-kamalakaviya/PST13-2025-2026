    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="r" type="Integer" array="False" size=""/>
            <input variable="r"/>
            <declare name="circum" type="Integer" array="False" size=""/>
            <input variable="circum"/>
            <assign variable="circum" expression="2*3.14*r"/>
            <output expression="&quot;circumference of the circle&quot;" newline="True"/>
        </body>
    </function>
